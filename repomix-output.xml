generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  MANAGER
  STAFF
}


model User {

  id String @id @default(uuid())

  username String @unique

  password String

  fullName String

  role Role @default(STAFF)


  inventoryLogs InventoryLog[]

  inventoryCounts InventoryCount[]

  sessions InventorySession[]

  voiceRecords VoiceRecord[]

  voiceSessions VoiceSession[]

  auditLogs AuditLog[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}



model Warehouse {

  id String @id @default(uuid())


  name String

  code String @unique


  isActive Boolean @default(true)


  locations Location[]

  sessions InventorySession[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}




enum LocationLevel {

  WAREHOUSE

  ZONE

  RACK

  SHELF

  BIN

}



model LocationType {

  id String @id @default(uuid())


  name String

  level LocationLevel


  locations Location[]

}




model Location {

  id String @id @default(uuid())


  name String


  code String @unique


  barcode String @unique


  warehouseId String?

  warehouse Warehouse?
    @relation(
      fields:[warehouseId],
      references:[id]
    )


  typeId String

  type LocationType
    @relation(
      fields:[typeId],
      references:[id]
    )



  parentId String?


  parent Location?
    @relation(
      "LocationTree",
      fields:[parentId],
      references:[id]
    )


  children Location[]
    @relation("LocationTree")



  inventories Inventory[]

  inventoryLogs InventoryLog[]

  inventoryCounts InventoryCount[]



  sessionLocations InventorySessionLocation[]


  isActive Boolean @default(true)


  deletedAt DateTime?


  sortOrder Int @default(0)



  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt


}





model Category {

  id String @id @default(uuid())


  name String @unique


  code String @unique



  products Product[]

  inventoryItems InventoryItem[]


  createdAt DateTime @default(now())

}




model Brand {

  id String @id @default(uuid())


  name String @unique



  products Product[]

  inventoryItems InventoryItem[]


  createdAt DateTime @default(now())

}





model Supplier {

  id String @id @default(uuid())


  name String


