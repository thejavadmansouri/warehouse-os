model VoiceSession {

  id String @id @default(uuid())


  userId String?

  user User?
    @relation(
      fields:[userId],
      references:[id]
    )


  startedAt DateTime @default(now())

  finishedAt DateTime?


  items InventoryItem[]

  isActive Boolean @default(true)

}
