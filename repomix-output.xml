      dto.locationBarcode,
      dto.text,
      dto.sessionId
    );

  }





  // خروج کالا
  @UseGuards(JwtAuthGuard)
  @UseGuards(JwtAuthGuard)
  @UseGuards(JwtAuthGuard)
  @Post('out')
  out(
    @Body() dto:any,
    @Req() req:any
  ){

    return this.service.out({
      ...dto,
      userId:req.user.id
    });

  }

  @UseGuards(JwtAuthGuard)
@Post('scan-out')
scanOut(
  @Body() dto:ScanOutDto,
  @Req() req:any
){

  return this.service.scanOut({
    ...dto,
    userId:req.user.id
  });

}
}
