{
  "name": "warehouse-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@warehouse-os/api",
    "dev:web": "npm run dev --workspace=@warehouse-os/web",
    "build:api": "npm run build --workspace=@warehouse-os/api",
    "build:web": "npm run build --workspace=@warehouse-os/web",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  }
}
