{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warehouse OS",
  "version": "0.1.0",
  "identifier": "com.warehouseos.seller",

  "build": {
    "devUrl": "http://localhost:3001",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": ["Persian", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
