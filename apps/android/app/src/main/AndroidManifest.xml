<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Justified in Epic 10: camera for barcode scan, mic for Persian voice entry,
         network for the LAN backend, network-state for the offline sync trigger. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Pick-task alerts: heads-up notifications + sound + vibration (Epic 0). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background polling while the worker is logged in (Android 14+ needs the type).
         specialUse, not dataSync: dataSync is capped at 6h per day on Android 15 and
         would be killed mid-shift (and crash the app if it ignored onTimeout). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Play the alert sound even when the phone is in Do-Not-Disturb. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".OperatorApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarehouseOperator"
        tools:targetApi="31">

        <!-- usesCleartextTraffic: the on-prem LAN server is plain HTTP, not HTTPS.
             Scoped to the network-security-config so only LAN hosts are allowed. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WarehouseOperator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- On-demand WorkManager init: remove the default initializer so our
             Hilt WorkerFactory (OperatorApplication.Configuration.Provider) is used. -->
        <!-- Watches the worker pick queue and rings the phone on new tasks. -->
        <service
            android:name=".data.notifications.PickTaskWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-prem LAN pick-task channel open for the
                    whole warehouse shift so the worker is alerted the moment a
                    seller sends work. No FCM is reachable on this network." />
        </service>

        <!-- Lets the camera app write the capture straight into app-private
             storage: the photo never touches shared/external storage, so it is
             not visible to the gallery or to other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
