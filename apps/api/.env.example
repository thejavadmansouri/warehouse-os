# نمونه‌ی تنظیمات سرور. کپی کنید به `.env` و مقادیر را پر کنید.
# خودِ `.env` هرگز کامیت نمی‌شود.

# اتصال به پستگرس.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/warehouse_os?schema=public"

# کلید امضای توکن ورود.
#
# ⚠️ باید برای هر نصب **یکتا** ساخته شود. اگر همه‌ی نصب‌ها یک کلید داشته باشند،
# هرکس آن را بداند می‌تواند روی هر سیستمی توکن مدیر جعل کند. سرور بدون این
# مقدار بالا نمی‌آید — عمداً، تا هیچ نصبی بی‌صدا ناامن اجرا نشود.
#
# ساختنش:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# تأیید خودکار ورودی صوتی. خاموش است چون دقت مچر ۷۱٪ بود.
AUTO_CONFIRM_ENABLED=false
