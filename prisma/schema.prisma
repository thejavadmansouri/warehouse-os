// کاردو B2B — اسکیمای کامل فاز ۲+ (کاتالوگ، خرید سریع، کیف پول، پرداخت، اعتبار)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// یک شرکت/مشتری عمده — ورود با موبایل یا یوزرنیم
model Customer {
  id            String   @id @default(cuid())
  companyName   String
  contactName   String
  phone         String   @unique
  username      String?  @unique
  passwordHash  String?
  nationalId    String?
  address       String?
  status        CustomerStatus @default(PENDING)
  tierId        String?
  tier          Tier?    @relation(fields: [tierId], references: [id])
  discountPercent Decimal @default(0) @db.Decimal(5, 2) // تخفیف اختصاصی مشتری
  creditLimitOverride Decimal? @db.Decimal(18, 0) // جایگزین سقف طبقه
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  orders        Order[]
  walletTx      WalletTransaction[]
  payments      Payment[]
  inquiries     Inquiry[]
  cheques       Cheque[]
  rmaRequests   RmaRequest[]
  notifications Notification[]
  stockAlerts   StockAlert[]
  searchLogs    CustomerSearchLog[]

  @@index([status])
  @@map("customers")
}

/// طبقه مشتری — مبنای سقف اعتبار و تخفیف پایه
model Tier {
  id          String   @id @default(cuid())
  name        String   @unique
  creditLimit Decimal? @db.Decimal(18, 0)
  baseDiscount Decimal? @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
  customers   Customer[]

  @@map("tiers")
}

/// کد OTP برای ورود با موبایل
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// ادمین پنل B2B و پرسنل (مدیر ارشد، حسابدار، انباردار)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN") // ADMIN, ACCOUNTANT, WAREHOUSE
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  approvedOrders Order[] @relation("OrderApprover")

  @@map("admin_users")
}

/// محصول — کد فنی/OEM/بارکد، قیمت پایه، موجودی، بسته‌بندی
model Product {
  id          String  @id @default(cuid())
  sku         String  @unique // کد فنی
  oemCode     String?
  barcode     String?
  name        String
  description String?
  brand       String  // خودرو / برند خودرو: پراید، پژو، سمند، ...
  model       String? // مدل خودرو: ۱۳۱، ۲۰۶، EF7، ...
  category    String  // قسمت خودرو: ترمز، موتور، تعلیق و جلوبندی، گیربکس، فیلتراسیون، ...
  partBrand   String? // برند سازنده قطعه: ایساکو، عظام، والئو، سرکان، دایکو، ...
  unit        String  @default("عدد") // واحد فروش
  packSize    Int     @default(1) // گام سفارش (مثلاً جین ۴ عددی)
  minQty      Int     @default(1) // حداقل سفارش
  price       Decimal @db.Decimal(18, 0) // قیمت پایه به تومان
  stockQty    Int     @default(0)
  imageUrl    String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  volumePrices VolumePrice[]
  orderItems   OrderItem[]
  rmaRequests  RmaRequest[]
  warehouseStocks WarehouseStock[]
  transferItems StockTransferItem[]
  stockAlerts   StockAlert[]

  @@index([brand, model, category])
  @@index([isActive])
  @@map("products")
}

/// تخفیف پله‌ای: از تعداد qtyFrom به بالا، این درصد تخفیف
model VolumePrice {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  qtyFrom     Int
  discountPercent Decimal @db.Decimal(5, 2)

  @@unique([productId, qtyFrom])
  @@map("volume_prices")
}

/// روش ارسال — قابل مدیریت در آینده
model ShippingMethod {
  id        String  @id @default(cuid())
  code      String  @unique // PICKUP | KERMAN_COURIER | FREIGHT
  name      String
  cost      Decimal @db.Decimal(18, 0) // کرایه ثابت (تومان) — باربری ۰ و پس‌کرایه
  freeAbove Decimal? @db.Decimal(18, 0) // بالای این مبلغ رایگان
  note      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders    Order[]

  @@map("shipping_methods")
}

/// پیش‌فاکتور / فاکتور
model Order {
  id            String   @id @default(cuid())
  number        String   @unique // PF-1405-0001
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  status        OrderStatus @default(PROFORMA)
  shippingId    String?
  shipping      ShippingMethod? @relation(fields: [shippingId], references: [id])
  shippingCost  Decimal  @default(0) @db.Decimal(18, 0)
  subtotal      Decimal  @db.Decimal(18, 0)
  discountTotal Decimal  @default(0) @db.Decimal(18, 0)
  total         Decimal  @db.Decimal(18, 0)
  paidWallet    Decimal  @default(0) @db.Decimal(18, 0)
  paidGateway   Decimal  @default(0) @db.Decimal(18, 0)
  creditAmount  Decimal  @default(0) @db.Decimal(18, 0)
  note          String?
  publicToken   String   @unique // لینک اشتراک بدون لاگین
  expiresAt     DateTime? // رزرو موجودی
  creditDueAt   DateTime?
  approvedById  String?
  approvedBy    AdminUser? @relation("OrderApprover", fields: [approvedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
  payments      Payment[]
  shipment      Shipment?
  rmaRequests   RmaRequest[]

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String // عکس‌برداری از نام محصول در لحظه خرید
  sku         String
  unit        String
  qty         Int
  unitPrice   Decimal @db.Decimal(18, 0) // قیمت واحد پس از تخفیف
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(18, 0)

  @@map("order_items")
}

/// تراکنش کیف پول (دفتر کل ساده، مبلغ علامت‌دار به تومان)
model WalletTransaction {
  id          String  @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        WalletTxType
  amount      Decimal @db.Decimal(18, 0) // مثبت = افزایش، منفی = کاهش
  balanceAfter Decimal @db.Decimal(18, 0)
  refType     String? // ORDER | PAYMENT | MANUAL
  refId       String?
  idempotencyKey String @unique
  note        String?
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTxType {
  TOPUP_ONLINE
  TOPUP_MANUAL
  PURCHASE
  REFUND
  ADJUST
}

/// پرداخت آنلاین (درگاه) — برای سفارش یا شارژ کیف پول
model Payment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  purpose     PaymentPurpose
  provider    String   @default("zarinpal")
  amount      Decimal  @db.Decimal(18, 0) // تومان
  authority   String?
  refId       String?
  status      PaymentStatus @default(PENDING)
  idempotencyKey String @unique
  createdAt   DateTime @default(now())
  verifiedAt  DateTime?

  @@index([customerId, createdAt])
  @@map("payments")
}

enum PaymentPurpose {
  ORDER
  WALLET_TOPUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// شمارنده اسناد — شماره‌گذاری پیش‌فاکتور بدون شکاف
model DocumentCounter {
  key   String @id
  value Int    @default(0)

  @@map("document_counters")
}

enum OrderStatus {
  PROFORMA // پیش‌فاکتور — منتظر پرداخت
  AWAITING_CREDIT_APPROVAL // درخواست خرید اعتباری
  APPROVED_CREDIT // اعتباری تأییدشده
  PAID
  CANCELLED
  EXPIRED
}

enum CustomerStatus {
  PENDING
  REJECTED
  ACTIVE
  BLOCKED
}

/// استعلام قیمت B2B (RFQ) — چندردیفی، با امکان قیمت‌گذاری ادمین و تبدیل به سفارش
model Inquiry {
  id               String        @id @default(cuid())
  number           String        @unique // RFQ-1405-0001
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status           InquiryStatus @default(PENDING)
  customerNote     String?
  adminNote        String?
  totalQuoted      Decimal?      @db.Decimal(18, 0)
  convertedOrderId String?       // در صورت تبدیل به پیش‌فاکتور
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            InquiryItem[]

  @@index([customerId, createdAt])
  @@index([status])
  @@map("inquiries")
}

model InquiryItem {
  id              String   @id @default(cuid())
  inquiryId       String
  inquiry         Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  productId       String?
  partName        String
  sku             String?
  brand           String?
  model           String?
  qty             Int      @default(1)
  unit            String   @default("عدد")
  targetPrice     Decimal? @db.Decimal(18, 0) // قیمت مدنظر مشتری (اختیاری)
  quotedUnitPrice Decimal? @db.Decimal(18, 0) // قیمت پیشنهادی ادمین
  lineTotal       Decimal? @db.Decimal(18, 0)
  adminNote       String?

  @@map("inquiry_items")
}

enum InquiryStatus {
  PENDING   // در انتظار بررسی ادمین
  ANSWERED  // قیمت‌گذاری شده توسط ادمین
  CONVERTED // تبدیل‌شده به پیش‌فاکتور
  REJECTED  // رد شده
}

/// وضعیت‌های فرآیند اعتبارسنجی چک صیادی
enum ChequeStatus {
  RECEIVED          // ثبت و دریافت شده (در انتظار تایید مدارک و استعلام صیاد)
  REGISTERED_SAYAD  // تایید ثبت در سامانه پیچک/صیاد بانک مرکزی
  CLEARED           // وصول و پاس شده
  BOUNCED           // برگشت خورده (نکول)
  REJECTED          // رد شده توسط کارشناس مالی
}

/// چک صیادی بنفش جهت تأمین اعتبار و خرید اقساطی ۳۰ تا ۶۰ روزه همکاران
model Cheque {
  id               String       @id @default(cuid())
  customerId       String
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sayadId          String       // شناسه ۱۶ رقمی یکتای صیاد
  chequeNumber     String       // شماره سریال چک
  bankName         String       // نام بانک صادرکننده (ملی، ملت، صادرات، تجارت، ...)
  branchName       String?      // نام یا کد شعبه
  accountNumber    String?      // شماره حساب
  drawerName       String       // نام و نام خانوادگی صاحب حساب
  drawerNationalId String?      // کدملی یا شناسه ملی صاحب حساب
  amount           Decimal      @db.Decimal(18, 0) // مبلغ چک به تومان
  issueDate        DateTime     // تاریخ صدور
  dueDate          DateTime     // تاریخ سررسید
  status           ChequeStatus @default(RECEIVED)
  adminNote        String?      // یادداشت واحد مالی
  sayadVerified    Boolean      @default(false) // آیا استعلام اهلیت صیاد انجام شده است؟
  imagePath        String?      // تصویر فیزیکی روی چک
  clearedAt        DateTime?
  bouncedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([customerId, status])
  @@index([sayadId])
  @@index([dueDate])
  @@map("cheques")
}

/// وضعیت‌های فرآیند ارسال بار و بیجک
enum ShipmentStatus {
  PREPARING        // در حال جمع‌آوری و بسته‌بندی در انبار مرکزی کرمان
  HANDED_TO_CARRIER // تحویل باربری یا پیک گردید
  DELIVERED        // تحویل همکار شد در مقصد
  CANCELLED        // لغو ارسال
}

/// شیوه پرداخت کرایه باربری
enum FreightPaymentType {
  PAY_ON_DELIVERY  // پس‌کرایه (پرداخت کرایه در مقصد به باربری)
  PREPAID          // پیش‌کرایه (محاسبه و دریافت روی فاکتور)
  FREE_SHIPPING    // ارسال رایگان سازمانی
}

/// حواله ارسال بار / بیجک باربری استان کرمان
model Shipment {
  id                 String             @id @default(cuid())
  orderId            String             @unique
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierName        String             // پیام شمس، پیشتاز، امید کرمان، پیک شهری کرمان، اتوبوسرانی و ...
  carrierPhone       String?            // شماره تماس دفتر باربری
  waybillNumber      String?            // شماره بیجک / شماره بارنامه
  destinationCity    String             // کرمان، سیرجان، رفسنجان، بم، جیرفت، زرند، کهنوج، شهربابک، بافت و ...
  destinationAddress String?            // آدرس تخلیه یا انبار باربری مقصد
  receiverName       String?            // نام تحویل‌گیرنده
  receiverPhone      String?            // موبایل تحویل‌گیرنده
  freightPaymentType FreightPaymentType @default(PAY_ON_DELIVERY)
  freightCost        Decimal?           @db.Decimal(18, 0)
  status             ShipmentStatus     @default(PREPARING)
  shippedAt          DateTime?
  deliveredAt        DateTime?
  adminNote          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
  @@index([destinationCity])
  @@index([waybillNumber])
  @@map("shipments")
}

/// وضعیت‌های مرجوعی کالا
enum RmaStatus {
  PENDING    // در انتظار بررسی کارشناس فنی و انبار
  APPROVED   // تأیید شده (ارسال قطعه معیوب به انبار)
  RECEIVED   // تحویل انبار گردید و تست شد
  REFUNDED   // عودت وجه به کیف پول مشتری انجام شد
  REJECTED   // رد درخواست مرجوعی
}

/// علت مرجوعی قطعه
enum RmaReason {
  DEFECTIVE             // خرابی و نقص فنی قطعه
  WRONG_ITEM            // مغایرت کد فنی یا کالای ارسالی با فاکتور
  DAMAGED_IN_SHIPPING   // آسیب‌دیدگی فیزیکی در حین باربری
  SURPLUS_ORDER         // انصراف یا سفارش مازاد همکار
}

/// درخواست مرجوعی قطعه (RMA)
model RmaRequest {
  id                 String    @id @default(cuid())
  number             String    @unique // RMA-1405-0001
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId          String
  product            Product   @relation(fields: [productId], references: [id])
  qty                Int       @default(1)
  reason             RmaReason
  customerNote       String
  adminNote          String?
  status             RmaStatus @default(PENDING)
  refundAmount       Decimal?  @db.Decimal(18, 0)
  refundWalletTxId   String?
  approvedAt         DateTime?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([customerId, status])
  @@index([orderId])
  @@map("rma_requests")
}

/// وضعیت‌های حواله جابجایی کالا بین انبارها
enum StockTransferStatus {
  DRAFT       // پیش‌نویس حواله
  IN_TRANSIT  // بارگیری و در حال حمل بین انبارها
  RECEIVED    // تخلیه و دریافت کامل در انبار مقصد
  CANCELLED   // لغو شده
}

/// انبار فیزیکی (انبار مرکزی کرمان، انبارهای منطقه‌ای رفسنجان، سیرجان، جیرفت و ...)
model Warehouse {
  id             String           @id @default(cuid())
  code           String           @unique // WH-KERMAN-CENTRAL, WH-RAF-01, ...
  name           String           // نام انبار
  city           String           // کرمان، رفسنجان، سیرجان، جیرفت و ...
  address        String
  phone          String?
  managerName    String?          // نام انباردار مسئول
  isCentral      Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  stocks         WarehouseStock[]
  transfersOut   StockTransfer[]  @relation("TransferSource")
  transfersIn    StockTransfer[]  @relation("TransferDest")

  @@index([city])
  @@map("warehouses")
}

/// موجودی قطعه به تفکیک انبار و موقعیت قفسه
model WarehouseStock {
  id            String    @id @default(cuid())
  warehouseId   String
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int       @default(0) // موجودی فیزیکی
  reservedQty   Int       @default(0) // رزرو شده در فاکتورها
  shelfLocation String?   // لوکیشن قفسه: مثال A-12-3 (راهرو A، ردیف ۱۲، طبقه ۳)
  minAlertQty   Int       @default(5)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
  @@map("warehouse_stocks")
}

/// حواله انتقال کالا بین انبارها (Warehouse Transfer)
model StockTransfer {
  id              String              @id @default(cuid())
  number          String              @unique // TRF-1405-0001
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("TransferSource", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("TransferDest", fields: [toWarehouseId], references: [id])
  status          StockTransferStatus @default(DRAFT)
  driverName      String?             // نام راننده حامل
  driverPhone     String?             // موبایل راننده
  vehiclePlate    String?             // پلاک خودرو
  dispatchedAt    DateTime?           // زمان خروج از انبار مبدأ
  receivedAt      DateTime?           // زمان ورود به انبار مقصد
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           StockTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  qty        Int

  @@map("stock_transfer_items")
}

/// انواع اعلان‌های مشتری و سیستم
enum NotificationType {
  ORDER_STATUS
  BIJAK_ISSUED
  CHEQUE_STATUS
  CREDIT_UPDATE
  RMA_UPDATE
  PROMO
  SYSTEM
}

/// اعلان‌های درون‌برنامه‌ای و پیامک‌های اطلاع‌رسانی
model Notification {
  id          String           @id @default(cuid())
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        NotificationType @default(SYSTEM)
  title       String
  message     String
  link        String?
  read        Boolean          @default(false)
  smsSent     Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([customerId, read])
  @@index([createdAt])
  @@map("notifications")
}

/// کلیدهای API برای نرم‌افزارهای حسابداری (پارسیان، هلو، سپیدار و...)
model ApiKey {
  id          String    @id @default(cuid())
  name        String    // نام اتصال (مثلاً: حسابداری پارسیان شعبه ۱)
  key         String    @unique // توکن امن احراز هویت
  system      String?   // PARSIAN, SEPPO, HOLOO, OTHER
  role        String    @default("ACCOUNTING")
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

/// بنرها و اطلاعیه‌های همگانی سیستم برای مدیران و کاربران
model Announcement {
  id        String    @id @default(cuid())
  title     String
  message   String
  level     String    @default("INFO") // INFO, SUCCESS, WARNING, URGENT
  target    String    @default("ALL")  // ALL, CUSTOMER, ADMIN
  link      String?
  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([isActive, target])
  @@map("announcements")
}

/// اعلان‌های داخلی مدیریت (سفارش جدید، چک، ثبت‌نام کاربر جدید، لاگ سیستم مالی)
model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO") // ORDER, CHEQUE, CUSTOMER, ACCOUNTING, SYSTEM
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read, createdAt])
  @@map("admin_notifications")
}

/// اشتراک اطلاع‌رسانی موجود شدن کالا («موجود شد خبرم کن»)
model StockAlert {
  id         String    @id @default(cuid())
  customerId String
  productId  String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([productId, notifiedAt])
  @@map("stock_alerts")
}

/// لاگ و تحلیل رفتار جستجوی مشتریان در کاتالوگ قطعات (CRM Search Analytics)
model CustomerSearchLog {
  id           String    @id @default(cuid())
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  query        String    // متن جستجو (مثلاً: کمک پراید، دیسک ۲۰۶)
  category     String?   // فیلتر دسته انتخابی
  brand        String?   // فیلتر خودرو
  partBrand    String?   // فیلتر برند سازنده
  resultsCount Int       @default(0) // تعداد نتایج یافت‌شده
  createdAt    DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([query])
  @@map("customer_search_logs")
}





