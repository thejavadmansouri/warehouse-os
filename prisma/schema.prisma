generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String             @id @default(uuid())
  username        String             @unique
  password        String
  fullName        String
  role            Role               @default(STAFF)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  auditLogs       AuditLog[]
  inventoryCounts InventoryCount[]
  inventoryLogs   InventoryLog[]
  sessions        InventorySession[]
  voiceRecords    VoiceRecord[]
  voiceSessions   VoiceSession[]
}

model Warehouse {
  id        String             @id @default(uuid())
  name      String
  code      String             @unique
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sessions  InventorySession[]
  locations Location[]
}

model LocationType {
  id        String        @id @default(uuid())
  name      String
  level     LocationLevel
  locations Location[]
}

model Location {
  id               String                     @id @default(uuid())
  name             String
  code             String                     @unique
  barcode          String                     @unique
  warehouseId      String?
  typeId           String
  parentId         String?
  isActive         Boolean                    @default(true)
  deletedAt        DateTime?
  sortOrder        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  inventories      Inventory[]
  inventoryCounts  InventoryCount[]
  inventoryLogs    InventoryLog[]
  sessionLocations InventorySessionLocation[]
  parent           Location?                  @relation("LocationTree", fields: [parentId], references: [id])
  children         Location[]                 @relation("LocationTree")
  type             LocationType               @relation(fields: [typeId], references: [id])
  warehouse        Warehouse?                 @relation(fields: [warehouseId], references: [id])
}

model Category {
  id             String          @id @default(uuid())
  name           String          @unique
  code           String          @unique
  createdAt      DateTime        @default(now())
  inventoryItems InventoryItem[]
  products       Product[]
}

model Brand {
  id             String          @id @default(uuid())
  name           String          @unique
  aliases        String[]        @default([])
  createdAt      DateTime        @default(now())
  inventoryItems InventoryItem[]
  products       Product[]
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model VehicleModel {
  id             String          @id @default(uuid())
  name           String
  aliases        String[]        @default([])
  startYear      Int
  endYear        Int
  systemType     String?
  createdAt      DateTime        @default(now())
  inventoryItems InventoryItem[]
  products       Product[]

  @@unique([name, startYear, endYear])
}

model PartCatalog {
  id        String    @id @default(uuid())
  name      String    @unique
  aliases   String[]  @default([])
  unit      String    @default("عدد")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String           @id @default(uuid())
  name            String
  sku             String           @unique
  internalBarcode String           @unique @default(uuid())
  partNumber      String?
  partCatalogId   String?
  description     String?
  unit            String           @default("عدد")
  weight          Float?
  minStock        Int              @default(0)
  categoryId      String?
  brandId         String?
  vehicleModelId  String?
  supplierId      String?
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accountingSyncs AccountingSync[]
  assets          Asset[]
  inventories     Inventory[]
  inventoryItems  InventoryItem[]
  inventoryLogs   InventoryLog[]
  brand           Brand?           @relation(fields: [brandId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  partCatalog     PartCatalog?     @relation(fields: [partCatalogId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  vehicleModel    VehicleModel?    @relation(fields: [vehicleModelId], references: [id])
  barcodes        ProductBarcode[]
  prices          ProductPrice[]
  voiceRecords    VoiceRecord[]
}

model ProductBarcode {
  id        String      @id @default(uuid())
  barcode   String      @unique
  type      BarcodeType
  productId String
  createdAt DateTime    @default(now())
  product   Product     @relation(fields: [productId], references: [id])
}

model ProductPrice {
  id             String   @id @default(uuid())
  productId      String
  purchasePrice  Int?
  salePrice      Int?
  wholesalePrice Int?
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
}

model Asset {
  id             String        @id @default(uuid())
  path           String
  fileName       String?
  type           AssetType
  productId      String?
  inventoryLogId String?
  createdAt      DateTime      @default(now())
  inventoryLog   InventoryLog? @relation(fields: [inventoryLogId], references: [id])
  product        Product?      @relation(fields: [productId], references: [id])
}

model Inventory {
  id         String   @id @default(uuid())
  productId  String
  locationId String
  quantity   Int      @default(0)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
}

model InventoryLog {
  id            String            @id @default(uuid())
  productId     String
  locationId    String
  quantity      Int
  action        InventoryAction
  note          String?
  userId        String?
  sessionId     String?
  voiceRecordId String?
  createdAt     DateTime          @default(now())
  source        String            @default("MANUAL")
  assets        Asset[]
  location      Location          @relation(fields: [locationId], references: [id])
  product       Product           @relation(fields: [productId], references: [id])
  session       InventorySession? @relation(fields: [sessionId], references: [id])
  user          User?             @relation(fields: [userId], references: [id])
  voiceRecord   VoiceRecord?      @relation(fields: [voiceRecordId], references: [id])
}

model InventorySession {
  id          String                     @id @default(uuid())
  warehouseId String?
  userId      String?
  startedAt   DateTime                   @default(now())
  finishedAt  DateTime?
  status      String                     @default("OPEN")
  counts      InventoryCount[]
  logs        InventoryLog[]
  user        User?                      @relation(fields: [userId], references: [id])
  warehouse   Warehouse?                 @relation(fields: [warehouseId], references: [id])
  locations   InventorySessionLocation[]
}

model InventorySessionLocation {
  id         String           @id @default(uuid())
  sessionId  String
  locationId String
  status     String           @default("PENDING")
  startedAt  DateTime?
  finishedAt DateTime?
  location   Location         @relation(fields: [locationId], references: [id])
  session    InventorySession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, locationId])
}

model InventoryCount {
  id         String           @id @default(uuid())
  sessionId  String
  locationId String
  userId     String?
  status     String           @default("OPEN")
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
  location   Location         @relation(fields: [locationId], references: [id])
  session    InventorySession @relation(fields: [sessionId], references: [id])
  user       User?            @relation(fields: [userId], references: [id])
  items      InventoryItem[]
}

model InventoryItem {
  reviewStatus       String         @default("NEEDS_REVIEW")
  id                 String         @id @default(uuid())
  countId            String
  productId          String?
  name               String
  categoryId         String?
  brandId            String?
  vehicleModelId     String?
  goodQuantity       Int            @default(0)
  badQuantity        Int            @default(0)
  image              String?
  note               String?
  voiceText          String?
  voiceConfidence    Float?
  recognizedName     String?
  recognizedBrand    String?
  recognizedCategory String?
  voiceSessionId     String?
  createdAt          DateTime       @default(now())
  brand              Brand?         @relation(fields: [brandId], references: [id])
  category           Category?      @relation(fields: [categoryId], references: [id])
  count              InventoryCount @relation(fields: [countId], references: [id])
  product            Product?       @relation(fields: [productId], references: [id])
  vehicleModel       VehicleModel?  @relation(fields: [vehicleModelId], references: [id])
  voiceSession       VoiceSession?  @relation(fields: [voiceSessionId], references: [id])
  barcodes           ItemBarcode[]
}

model ItemBarcode {
  id        String        @id @default(uuid())
  itemId    String
  barcode   String        @unique
  status    BarcodeStatus @default(GOOD)
  createdAt DateTime      @default(now())
  item      InventoryItem @relation(fields: [itemId], references: [id])
}

model VoiceRecord {
  id            String         @id @default(uuid())
  filePath      String
  text          String?
  confidence    Float?
  status        String         @default("PENDING")
  productId     String?
  userId        String?
  createdAt     DateTime       @default(now())
  inventoryLogs InventoryLog[]
  product       Product?       @relation(fields: [productId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
}

model AccountingSync {
  id         String    @id @default(uuid())
  productId  String
  system     String
  externalId String?
  lastSync   DateTime?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model VoiceSession {
  id         String          @id @default(uuid())
  userId     String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  isActive   Boolean         @default(true)
  items      InventoryItem[]
  user       User?           @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum LocationLevel {
  WAREHOUSE
  ZONE
  RACK
  SHELF
  BIN
}

enum BarcodeType {
  INTERNAL
  FACTORY
  QR
  OTHER
}

enum AssetType {
  PRODUCT_IMAGE
  DAMAGE_IMAGE
  INVOICE_IMAGE
  INVENTORY_IMAGE
  OTHER
}

enum InventoryAction {
  IN
  OUT
  TRANSFER
  ADJUST
  SALE
  RETURN
  COUNT
}

enum BarcodeStatus {
  GOOD
  BAD
  UNKNOWN
}

enum ImportRowStatus {
  READY
  NEW_BRAND
  NEW_PART
  NEW_VEHICLE
  COMPLETED
  FAILED
}

model ImportJob {
  id          String      @id @default(uuid())
  fileName    String?
  status      String      @default("PENDING")
  totalRows   Int         @default(0)
  successRows Int         @default(0)
  failedRows  Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  rows        ImportRow[]
}

model ImportRow {
  id        String @id @default(uuid())
  jobId     String
  rowNumber Int

  productName      String?
  brandName        String?
  vehicleModelName String?
  partNumber       String?
  unit             String?

  purchasePrice  Float?
  salePrice      Float?
  wholesalePrice Float?

  matchedBrandId   String?
  matchedCatalogId String?
  matchedVehicleId String?

  rawData Json?
  status  ImportRowStatus @default(READY)
  error   String?

  createdAt DateTime @default(now())

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
