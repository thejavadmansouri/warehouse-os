generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id String @id @default(uuid())

  name String @unique
  code String @unique

  products Product[]
}

model Brand {
  id String @id @default(uuid())

  name String @unique

  products Product[]
}

model VehicleModel {
  id String @id @default(uuid())

  name       String
  startYear  Int
  endYear    Int
  systemType String?

  products Product[]

  @@unique([name, startYear, endYear])
}

model Warehouse {
  id String @id @default(uuid())

  name String

  code String @unique

  locations Location[]

  sessions InventorySession[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid())

  name String

  sku String @unique

  internalBarcode String @unique

  factoryBarcode String? @unique

  partNumber String?

  purchasePrice Int?

  salePrice Int?

  minStock Int @default(0)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  image String?

  isActive Boolean @default(true)

  deletedAt DateTime?

  inventoryLogs InventoryLog[]

  inventories Inventory[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model LocationType {
  id String @id @default(uuid())

  name String

  level Int

  locations Location[]
}

model Location {
  id String @id @default(uuid())

  name String

  barcode String @unique

  warehouseId String?

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  typeId String

  type LocationType @relation(fields: [typeId], references: [id])

  parentId String?

  parent Location? @relation("LocationTree", fields: [parentId], references: [id])

  children Location[] @relation("LocationTree")

  isActive Boolean @default(true)

  deletedAt DateTime?

  inventories Inventory[]

  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())

  inventorySessionLocations InventorySessionLocation[]
}

enum InventoryAction {
  IN
  OUT
  TRANSFER
  ADJUST
  SALE
  RETURN
  COUNT
}

model Inventory {
  id String @id @default(uuid())

  productId String

  product Product @relation(fields: [productId], references: [id])

  locationId String

  location Location @relation(fields: [locationId], references: [id])

  quantity Int @default(0)

  version Int @default(1)

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
}

model InventoryLog {
  id String @id @default(uuid())

  productId String

  product Product @relation(fields: [productId], references: [id])

  locationId String

  location Location @relation(fields: [locationId], references: [id])

  quantity Int

  action InventoryAction

  note String?

  image String?

  userId String?

  user User? @relation(fields: [userId], references: [id])

  sessionId String?

  session InventorySession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

enum Role {
  ADMIN

  MANAGER

  STAFF
}

model User {
  id String @id @default(uuid())

  username String @unique

  password String

  fullName String

  role Role @default(STAFF)

  inventoryLogs InventoryLog[]

  sessions InventorySession[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model InventorySessionLocation {
  id String @id @default(uuid())

  sessionId String

  session InventorySession @relation(fields: [sessionId], references: [id])

  locationId String

  location Location @relation(fields: [locationId], references: [id])

  status String @default("PENDING")

  startedAt DateTime?

  finishedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([sessionId, locationId])
}

model InventorySession {
  id String @id @default(uuid())

  warehouseId String?

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])

  userId String?

  user User? @relation(fields: [userId], references: [id])

  startedAt DateTime @default(now())

  finishedAt DateTime?

  logs InventoryLog[]

  locations InventorySessionLocation[]
}
